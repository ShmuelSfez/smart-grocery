{
  "manifest_version": 3,
  "name": "העגלה החכמה – מילוי סל בשופרסל, רמי לוי וקרפור (לא רשמי)",
  "short_name": "SmartCart",
  "version": "3.0.0",
  "description": "כלי עצמאי ובלתי רשמי למילוי סל בלחיצה אחת ומעבר לתשלום בשופרסל, רמי לוי וקרפור ישראל.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.shufersal.co.il/*",
    "https://www.rami-levy.co.il/*",
    "https://www.carrefour.co.il/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "העגלה החכמה (לא רשמי)",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://shmuelsfez.github.io/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.shufersal.co.il/*",
        "https://www.rami-levy.co.il/*",
        "https://www.carrefour.co.il/*"
      ],
      "js": ["capture.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.shufersal.co.il/*",
        "https://www.rami-levy.co.il/*",
        "https://www.carrefour.co.il/*"
      ],
      "js": ["codec.js", "panel.js"],
      "run_at": "document_idle"
    }
  ]
}
