{
  "manifest_version": 3,
  "name": "העגלה החכמה – מילוי סל ב-7 רשתות שיווק (לא רשמי)",
  "short_name": "SmartCart",
  "version": "3.1.1",
  "description": "כלי עצמאי ובלתי רשמי למילוי סל ומעבר לתשלום בשופרסל, רמי לוי, קרפור, מחסני השוק, ויקטורי, יוחננוף וטיב טעם.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.shufersal.co.il/*",
    "https://www.rami-levy.co.il/*",
    "https://www.carrefour.co.il/*",
    "https://www.mck.co.il/*",
    "https://www.victoryonline.co.il/*",
    "https://yochananof.co.il/*",
    "https://www.tivtaam.co.il/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "העגלה החכמה (לא רשמי)",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://shmuelsfez.github.io/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.shufersal.co.il/*",
        "https://www.rami-levy.co.il/*",
        "https://www.carrefour.co.il/*",
        "https://www.mck.co.il/*",
        "https://www.victoryonline.co.il/*",
        "https://yochananof.co.il/*",
        "https://www.tivtaam.co.il/*"
      ],
      "js": ["capture.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.shufersal.co.il/*",
        "https://www.rami-levy.co.il/*",
        "https://www.carrefour.co.il/*",
        "https://www.mck.co.il/*",
        "https://www.victoryonline.co.il/*",
        "https://yochananof.co.il/*",
        "https://www.tivtaam.co.il/*"
      ],
      "js": [
        "codec.js",
        "chains/selfpoint.js",
        "chains/shufersal.js",
        "chains/ramilevy.js",
        "chains/carrefour.js",
        "chains/mahsaneihashuk.js",
        "chains/victory.js",
        "chains/yochananof.js",
        "chains/tivtaam.js",
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
