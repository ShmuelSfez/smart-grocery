{
  "manifest_version": 3,
  "name": "העגלה החכמה – מילוי סל ברמי לוי ושופרסל (לא רשמי)",
  "short_name": "SmartCart",
  "version": "2.2.0",
  "description": "כלי עצמאי ובלתי רשמי להשוואת סלים ומילוי אוטומטי של סל הקניות ברמי לוי ובשופרסל.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.shufersal.co.il/*",
    "https://www.rami-levy.co.il/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "העגלה החכמה (לא רשמי)",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://www.shufersal.co.il/*",
        "https://www.rami-levy.co.il/*"
      ],
      "js": ["capture.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.shufersal.co.il/*",
        "https://www.rami-levy.co.il/*"
      ],
      "js": ["codec.js", "panel.js"],
      "run_at": "document_idle"
    }
  ]
}
